@page "/settings"
@inject AppState State
@inject LocalStore Store
@inject UsdaService Usda
@inject IJSRuntime JS

<PageTitle>Settings</PageTitle>

<div class="page-header">
    <h1>Settings</h1>
</div>

<div class="settings-grid">
    <div class="card">
        <h3>Backup &amp; sync</h3>
        <p class="muted small">
            All data lives in this browser's local storage. To back up or move it to another
            device, export everything (menu items + schedule) as a JSON file and import it there.
            Keep the file in your own cloud storage (Drive, Dropbox, OneDrive…) to sync between devices.
        </p>

        @if (_importError is not null)
        {
            <div class="alert-error">@_importError</div>
        }
        @if (_importOk)
        {
            <div class="alert-ok">Import complete.</div>
        }

        <div class="btn-row">
            <button class="btn btn-accent" @onclick="ExportAsync">Export JSON</button>
            <label class="btn file-btn">
                Import JSON
                <InputFile OnChange="ImportAsync" accept=".json,application/json" />
            </label>
        </div>
    </div>

    <InstallPrompt Compact="true" />

    <div class="card">
        <h3>Support CalTrack</h3>
        <p class="muted small">
            CalTrack is free — no ads, no accounts, no tracking, and your data never leaves your device.
            If it's useful to you and you feel like saying thanks:
        </p>
        <div class="btn-row">
            <a class="btn coffee-btn" href="https://buymeacoffee.com/jakotheshadows" target="_blank" rel="noopener">☕ Buy me a coffee</a>
        </div>
    </div>

    <div class="card">
        <h3>USDA nutrition lookup</h3>
        <p class="muted small">
            Auto-fill calories, macros, and micros in the menu item editor by searching the USDA
            FoodData Central database (over 400,000 foods, including brand-name grocery items).
            It needs your own free API key — takes about a minute to get.
        </p>

        <ol class="muted small setup-steps">
            <li>Request a key at <a href="https://api.data.gov/signup/" target="_blank" rel="noopener">api.data.gov/signup</a> (just name + email — the key is shown/emailed instantly).</li>
            <li>Paste it below and save, then use <b>🔎 Search USDA</b> when adding or editing a menu item.</li>
        </ol>

        <label class="field">
            <span>API key</span>
            <input class="input" @bind="_usdaKey" placeholder="e.g. aBcDeFgH123…" />
        </label>
        <div class="btn-row">
            <button class="btn btn-accent" @onclick="SaveUsdaKeyAsync">Save key</button>
            <button class="btn" disabled="@(_testingKey || string.IsNullOrWhiteSpace(_usdaKey))" @onclick="TestUsdaKeyAsync">Test key</button>
            @if (_usdaKeyStatus is not null)
            {
                <span class="muted small update-status">@_usdaKeyStatus</span>
            }
        </div>
        <p class="muted small">The key stays in this browser's storage only — it is never included in JSON exports.</p>
    </div>

    <div class="card">
        <h3>App updates</h3>
        <p class="muted small">Installed version: <code>@(_version ?? "…")</code></p>
        <p class="muted small">
            Updates install automatically in the background; when one is ready, a banner appears
            with an “Update now” button. You can also check on demand here.
        </p>
        <div class="btn-row">
            <button class="btn" disabled="@_checkingUpdate" @onclick="CheckUpdatesAsync">Check for updates</button>
            @if (_updateStatus is not null)
            {
                <span class="muted small update-status">@_updateStatus</span>
            }
        </div>

        <hr class="sep" />

        <h3>Danger zone</h3>
        @if (_confirmClear)
        {
            <p class="muted small">This permanently deletes all menu items and schedule data stored in this browser. Export a backup first if you might want it back.</p>
            <div class="btn-row">
                <button class="btn btn-danger" @onclick="ClearAllAsync">Yes, delete everything</button>
                <button class="btn" @onclick="() => _confirmClear = false">Cancel</button>
            </div>
        }
        else
        {
            <div class="btn-row">
                <button class="btn btn-ghost-danger" @onclick="() => _confirmClear = true">Clear all local data…</button>
            </div>
        }
    </div>
</div>
