@page "/foods"
@implements IDisposable
@inject AppState State
@inject UsdaService Usda
@inject NavigationManager Nav

<PageTitle>CalTrack · Menu Items</PageTitle>

<div class="page-header">
    <h1>Menu Items</h1>
    <button class="btn btn-accent" @onclick="StartAdd">+ New item</button>
</div>

<div class="toolbar">
    <input class="input search" placeholder="Search items…" @bind="_search" @bind:event="oninput" />
    <select class="input" @bind="_categoryFilter">
        <option value="">All categories</option>
        <option value="Food">Food</option>
        <option value="Beverage">Beverage</option>
        <option value="Snack">Snack</option>
    </select>
</div>

@{ var items = Filtered().ToList(); }
@if (State.Data.Items.Count == 0)
{
    <div class="card empty-state">
        <p>No menu items yet. Add the foods, beverages, and snacks you eat — only a name is required.</p>
        <p class="muted small">Tip: the 🔎 Search USDA button in the editor can auto-fill calories, macros, and micros from the USDA food database.</p>
    </div>
}
else if (items.Count == 0)
{
    <div class="card empty-state"><p class="muted">No items match your search.</p></div>
}
else
{
    <div class="card table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Serving</th>
                    <th class="num">Calories</th>
                    <th class="num">Protein</th>
                    <th class="num">Carbs</th>
                    <th class="num">Fat</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>
                            <span class="item-name">@item.Name</span>
                            @if (item.ExcludeFromRandom)
                            {
                                <span class="badge badge-norand" title="Excluded from random generation">no 🎲</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="muted small item-desc">@item.Description</div>
                            }
                        </td>
                        <td><span class="badge badge-@item.Category.ToString().ToLowerInvariant()">@item.Category</span></td>
                        <td class="muted">@(item.ServingSize ?? "—")</td>
                        <td class="num">@(item.Calories?.ToString("N0") ?? "—")</td>
                        <td class="num">@FormatNutrient(item, "protein")</td>
                        <td class="num">@FormatNutrient(item, "carbs")</td>
                        <td class="num">@FormatNutrient(item, "fat")</td>
                        <td class="actions">
                            <button class="btn btn-sm" @onclick="() => StartEdit(item)">Edit</button>
                            @if (_confirmDelete == item.Name)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(item.Name)">Confirm?</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-ghost-danger" @onclick="() => _confirmDelete = item.Name">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="CancelEdit">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <h2>@(_originalName is null ? "New menu item" : $"Edit “{_originalName}”")</h2>

            @if (_error is not null)
            {
                <div class="alert-error">@_error</div>
            }

            <div class="form-grid">
                <label class="field span-2">
                    <span>Name <b class="req">*</b></span>
                    <div class="name-row">
                        <input class="input" @bind="_editing.Name" placeholder="e.g. Grilled chicken breast" />
                        <button class="btn" type="button" title="Auto-fill nutrition facts from the USDA food database" @onclick="OpenUsdaAsync">🔎 Search USDA</button>
                    </div>
                </label>
                <label class="field">
                    <span>Category</span>
                    <select class="input" @bind="_editing.Category">
                        <option value="@FoodCategory.Food">Food</option>
                        <option value="@FoodCategory.Beverage">Beverage</option>
                        <option value="@FoodCategory.Snack">Snack</option>
                    </select>
                </label>
                <label class="field">
                    <span>Serving size</span>
                    <input class="input" @bind="_editing.ServingSize" placeholder="e.g. 6 oz / 170 g" />
                </label>
                <label class="field span-2">
                    <span>Description</span>
                    <textarea class="input" rows="2" @bind="_editing.Description" placeholder="Optional notes"></textarea>
                </label>
                <label class="field">
                    <span>Calories (kcal)</span>
                    <input class="input" type="number" step="any" min="0" @bind="_editing.Calories" />
                </label>
                <label class="field checkbox-field">
                    <input type="checkbox" @bind="_editing.ExcludeFromRandom" />
                    <span>Exclude from randomize</span>
                </label>
            </div>

            @if (_usdaOpen)
            {
                <div class="usda-panel">
                    @if (!_usdaHasKey)
                    {
                        <p class="muted small">
                            Nutrition lookup searches the USDA FoodData Central database and fills in calories,
                            macros, and micros for you. It needs a free API key — about a minute to set up
                            (instructions are on the Settings page).
                        </p>
                        <div class="btn-row">
                            <button class="btn btn-accent" @onclick="GoToSettings">Set up in Settings</button>
                            <button class="btn" @onclick="() => _usdaOpen = false">Close</button>
                        </div>
                    }
                    else
                    {
                        <div class="usda-search-row">
                            <input class="input" placeholder="Search foods, brands…" @bind="_usdaQuery" @bind:event="oninput" @onkeydown="OnUsdaKeyDown" />
                            <button class="btn btn-accent" disabled="@_usdaBusy" @onclick="RunUsdaSearchAsync">@(_usdaBusy ? "Searching…" : "Search")</button>
                            <button class="btn" @onclick="() => _usdaOpen = false">Close</button>
                        </div>
                        @if (_usdaError is not null)
                        {
                            <div class="alert-error">@_usdaError</div>
                        }
                        @if (_usdaApplied is not null)
                        {
                            <div class="alert-ok">@_usdaApplied</div>
                        }
                        @if (_usdaSelected is not null)
                        {
                            <div class="usda-serving-row">
                                <span class="muted small">My serving is:</span>
                                <input class="input input-sm serving-amount" type="number" step="any" min="0"
                                       value="@_servAmount" @onchange="e => OnServingAmountChanged(e.Value?.ToString())" />
                                <select class="input serving-unit" value="@_servUnit" @onchange="e => OnServingUnitChanged(e.Value?.ToString())">
                                    @foreach (var unit in UsdaService.UnitsForBase(_usdaSelected.BaseUnit))
                                    {
                                        <option value="@unit">@unit</option>
                                    }
                                </select>
                                <span class="muted small">— nutrition below rescales automatically</span>
                            </div>
                        }
                        @if (_usdaResults is not null)
                        {
                            @if (_usdaResults.Count == 0)
                            {
                                <p class="muted small">No matches — try fewer or different words.</p>
                            }
                            else
                            {
                                <ul class="usda-results">
                                    @foreach (var f in _usdaResults)
                                    {
                                        <li @key="f.FdcId" @onclick="() => ApplyUsda(f)" title="Click to fill the form with this food's nutrition">
                                            <div class="usda-line1">
                                                <span class="item-name">@f.Description</span>
                                                <span class="num">@(f.CaloriesFor(f.DefaultAmount) is { } kcal ? $"{kcal:N0} kcal" : "—")</span>
                                            </div>
                                            <div class="muted small">@(f.Brand is null ? f.DataType : $"{f.Brand} · {f.DataType}") · per @f.DefaultServingDisplay</div>
                                        </li>
                                    }
                                </ul>
                                <p class="muted small">Click a result to fill the form — you can adjust anything before saving.</p>
                            }
                        }
                    }
                </div>
            }

            <h4 class="section-label">Macronutrients <span class="muted small">(per serving, optional)</span></h4>
            <div class="form-grid nutrients-grid">
                @foreach (var def in NutrientCatalog.Macros)
                {
                    <label class="field" @key="def.Key">
                        <span>@def.Label (@def.Unit)</span>
                        <input class="input" type="number" step="any" min="0"
                               value="@NutrientValue(def.Key)"
                               @onchange="e => SetNutrient(def.Key, e.Value?.ToString())" />
                    </label>
                }
            </div>

            <details class="micros-details" open="@_microsOpen">
                <summary @onclick="() => _microsOpen = !_microsOpen" @onclick:preventDefault="true">
                    Micronutrients <span class="muted small">(per serving, optional)</span>
                </summary>
                <div class="form-grid nutrients-grid">
                    @foreach (var def in NutrientCatalog.Micros)
                    {
                        <label class="field" @key="def.Key">
                            <span>@def.Label (@def.Unit)</span>
                            <input class="input" type="number" step="any" min="0"
                                   value="@NutrientValue(def.Key)"
                                   @onchange="e => SetNutrient(def.Key, e.Value?.ToString())" />
                        </label>
                    }
                </div>
            </details>

            <div class="btn-row modal-actions">
                <button class="btn btn-accent" @onclick="SaveAsync">Save</button>
                <button class="btn" @onclick="CancelEdit">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private string _search = "";
    private string _categoryFilter = "";
    private string? _confirmDelete;

    private FoodItem? _editing;
    private string? _originalName;
    private string? _error;
    private bool _microsOpen;

    private bool _usdaOpen;
    private bool _usdaHasKey;
    private string _usdaQuery = "";
    private bool _usdaBusy;
    private string? _usdaError;
    private string? _usdaApplied;
    private List<UsdaFood>? _usdaResults;
    private UsdaFood? _usdaSelected;
    private double _servAmount;
    private string _servUnit = "g";

    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;

    private IEnumerable<FoodItem> Filtered()
    {
        var q = State.Data.Items.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(i => i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                          || (i.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
        if (Enum.TryParse<FoodCategory>(_categoryFilter, out var cat))
            q = q.Where(i => i.Category == cat);
        return q;
    }

    private static string FormatNutrient(FoodItem item, string key)
    {
        var v = item.Nutrient(key);
        return v is null ? "—" : v.Value.ToString("0.#");
    }

    private void StartAdd()
    {
        _editing = new FoodItem();
        _originalName = null;
        _error = null;
        _microsOpen = false;
        ResetUsda();
    }

    private void StartEdit(FoodItem item)
    {
        _editing = item.Clone();
        _originalName = item.Name;
        _error = null;
        _microsOpen = NutrientCatalog.Micros.Any(m => item.Nutrients.ContainsKey(m.Key));
        ResetUsda();
    }

    private void CancelEdit()
    {
        _editing = null;
        _error = null;
        ResetUsda();
    }

    private void ResetUsda()
    {
        _usdaOpen = false;
        _usdaQuery = "";
        _usdaResults = null;
        _usdaError = null;
        _usdaApplied = null;
        _usdaSelected = null;
    }

    private async Task OpenUsdaAsync()
    {
        _usdaOpen = true;
        _usdaError = null;
        _usdaApplied = null;
        _usdaHasKey = await Usda.GetApiKeyAsync() is not null;
        if (_usdaHasKey && string.IsNullOrWhiteSpace(_usdaQuery))
            _usdaQuery = _editing?.Name ?? "";
    }

    private void GoToSettings() => Nav.NavigateTo("settings");

    private async Task OnUsdaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RunUsdaSearchAsync();
    }

    private async Task RunUsdaSearchAsync()
    {
        if (_usdaBusy) return;
        _usdaBusy = true;
        _usdaError = null;
        _usdaApplied = null;
        _usdaResults = null;
        _usdaSelected = null;
        (_usdaResults, _usdaError) = await Usda.SearchAsync(_usdaQuery);
        _usdaBusy = false;
    }

    private void ApplyUsda(UsdaFood food)
    {
        _usdaSelected = food;
        _servAmount = food.DefaultAmount;
        _servUnit = food.BaseUnit;
        FillFromSelected();
    }

    private void OnServingAmountChanged(string? raw)
    {
        if (double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v))
            _servAmount = v;
        FillFromSelected();
    }

    private void OnServingUnitChanged(string? unit)
    {
        if (!string.IsNullOrEmpty(unit)) _servUnit = unit;
        FillFromSelected();
    }

    private void FillFromSelected()
    {
        if (_editing is null || _usdaSelected is null) return;
        var baseAmount = UsdaService.ToBaseAmount(_servAmount, _servUnit, _usdaSelected.BaseUnit);
        if (baseAmount is null)
        {
            _usdaError = "Enter a serving amount greater than zero.";
            return;
        }
        _usdaError = null;
        if (string.IsNullOrWhiteSpace(_editing.Name)) _editing.Name = _usdaSelected.Description;
        _editing.ServingSize = ServingText(baseAmount.Value);
        _editing.Calories = _usdaSelected.CaloriesFor(baseAmount.Value);
        _editing.Nutrients = _usdaSelected.NutrientsFor(baseAmount.Value);
        _microsOpen = NutrientCatalog.Micros.Any(m => _editing.Nutrients.ContainsKey(m.Key));
        _usdaApplied = $"Filled from “{_usdaSelected.Description}” at {_editing.ServingSize} — change the serving below to rescale.";
    }

    private string ServingText(double baseAmount)
    {
        var food = _usdaSelected!;
        // The unmodified label serving keeps its household text, e.g. "0.5 cup (113 g)".
        if (food.LabelServingAmount is not null && _servUnit == food.BaseUnit &&
            Math.Abs(_servAmount - food.LabelServingAmount.Value) < 0.001)
            return food.DefaultServingDisplay;
        return _servUnit == food.BaseUnit
            ? $"{_servAmount:0.##} {_servUnit}"
            : $"{_servAmount:0.##} {_servUnit} ({baseAmount:0.#} {food.BaseUnit})";
    }

    private string? NutrientValue(string key)
    {
        var v = _editing?.Nutrient(key);
        return v?.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private void SetNutrient(string key, string? raw)
    {
        if (_editing is null) return;
        if (double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v))
            _editing.Nutrients[key] = v;
        else
            _editing.Nutrients.Remove(key);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _error = await State.UpsertItemAsync(_editing, _originalName);
        if (_error is null) CancelEdit();
    }

    private async Task DeleteAsync(string name)
    {
        _confirmDelete = null;
        await State.DeleteItemAsync(name);
    }
}
