@page "/foods"
@implements IDisposable
@inject AppState State

<PageTitle>Menu Items</PageTitle>

<div class="page-header">
    <h1>Menu Items</h1>
    @if (_tab == Tab.Items)
    {
        <button class="btn btn-accent" @onclick="StartAdd">+ New item</button>
    }
    else
    {
        <button class="btn btn-accent" @onclick="StartAddRecipe">+ New recipe</button>
    }
</div>

<div class="tab-bar">
    <button class="btn @(_tab == Tab.Items ? "btn-accent" : "")" @onclick="() => _tab = Tab.Items">Items</button>
    <button class="btn @(_tab == Tab.Recipes ? "btn-accent" : "")" @onclick="() => _tab = Tab.Recipes">Recipes@(State.Data.Recipes.Count > 0 ? $" ({State.Data.Recipes.Count})" : "")</button>
</div>

<div class="toolbar">
    <input class="input search" placeholder="@(_tab == Tab.Items ? "Search items…" : "Search recipes…")" @bind="_search" @bind:event="oninput" />
    @if (_tab == Tab.Items)
    {
        <select class="input" @bind="_categoryFilter">
            <option value="">All categories</option>
            <option value="Food">Food</option>
            <option value="Beverage">Beverage</option>
            <option value="Snack">Snack</option>
        </select>
    }
</div>

@if (_tab == Tab.Items)
{
    var items = Filtered().ToList();

    @if (_editing is not null && _originalName is null)
    {
        <div class="card editor-card">
            <ItemForm Item="_editing" Error="@_error" OnSave="SaveAsync" OnCancel="CancelEdit" />
        </div>
    }

    @if (State.Data.Items.Count == 0)
    {
        @if (_editing is null)
        {
            <div class="card empty-state">
                <p>No menu items yet. Add the foods, beverages, and snacks you eat — only a name is required.</p>
                <p class="muted small">Tip: the 🔎 Search USDA button in the editor can auto-fill calories, macros, and micros from the USDA food database.</p>
            </div>
        }
    }
    else if (items.Count == 0)
    {
        <div class="card empty-state"><p class="muted">No items match your search.</p></div>
    }
    else
    {
        <div class="card table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Serving</th>
                        <th class="num">Calories</th>
                        <th class="num">Protein</th>
                        <th class="num">Carbs</th>
                        <th class="num">Fat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        @if (_editing is not null && string.Equals(_originalName, item.Name, StringComparison.OrdinalIgnoreCase))
                        {
                            <tr class="editor-row" @key="item">
                                <td colspan="8">
                                    <ItemForm Item="_editing" OriginalName="@_originalName" Error="@_error" OnSave="SaveAsync" OnCancel="CancelEdit" />
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr @key="item">
                                <td>
                                    <span class="item-name">@item.Name</span>
                                    @if (item.ExcludeFromRandom)
                                    {
                                        <span class="badge badge-norand" title="Excluded from random generation">no 🎲</span>
                                    }
                                    <ItemDescription Text="@item.Description" />
                                </td>
                                <td><span class="badge badge-@item.Category.ToString().ToLowerInvariant()">@item.Category</span></td>
                                <td class="muted">@(item.ServingSize ?? "—")</td>
                                <td class="num">@(item.Calories?.ToString("N0") ?? "—")</td>
                                <td class="num">@FormatNutrient(item, "protein")</td>
                                <td class="num">@FormatNutrient(item, "carbs")</td>
                                <td class="num">@FormatNutrient(item, "fat")</td>
                                <td class="actions">
                                    <button class="btn btn-sm" @onclick="() => StartEdit(item)">Edit</button>
                                    <ConfirmButton OnConfirm="() => DeleteAsync(item.Name)" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    var recipes = FilteredRecipes().ToList();

    @if (_recipe is not null && _recipeOriginalName is null)
    {
        <div class="card editor-card">
            <RecipeForm Recipe="_recipe" Error="@_recipeError" OnSave="SaveRecipeAsync" OnCancel="CancelRecipe" />
        </div>
    }

    @if (State.Data.Recipes.Count == 0)
    {
        @if (_recipe is null)
        {
            <div class="card empty-state">
                <p>No recipes yet. A recipe is a set of ingredients with amounts — CalTrack totals the nutrition and divides it into servings.</p>
                <p class="muted small">Once saved, a recipe can be scheduled just like any other menu item (one serving at a time).</p>
            </div>
        }
    }
    else if (recipes.Count == 0)
    {
        <div class="card empty-state"><p class="muted">No recipes match your search.</p></div>
    }
    else
    {
        <div class="card table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="expander-cell"></th>
                        <th>Name</th>
                        <th class="num">Servings</th>
                        <th class="num">Ingredients</th>
                        <th class="num">Calories<span class="muted small"> /serv</span></th>
                        <th class="num">Protein</th>
                        <th class="num">Carbs</th>
                        <th class="num">Fat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var recipe in recipes)
                    {
                        @if (_recipe is not null && string.Equals(_recipeOriginalName, recipe.Name, StringComparison.OrdinalIgnoreCase))
                        {
                            <tr class="editor-row" @key="recipe">
                                <td colspan="9">
                                    <RecipeForm Recipe="_recipe" OriginalName="@_recipeOriginalName" Error="@_recipeError" OnSave="SaveRecipeAsync" OnCancel="CancelRecipe" />
                                </td>
                            </tr>
                        }
                        else
                        {
                            var view = recipe.ToMenuItem();
                            var expanded = _expanded.Contains(recipe.Name);
                            <tr @key="recipe">
                                <td class="expander-cell">
                                    <button class="icon-btn expander" title="@(expanded ? "Hide ingredients" : "Show ingredients")"
                                            @onclick="() => ToggleExpanded(recipe.Name)">@(expanded ? "▾" : "▸")</button>
                                </td>
                                <td>
                                    <span class="item-name">@recipe.Name</span>
                                    @if (recipe.ExcludeFromRandom)
                                    {
                                        <span class="badge badge-norand" title="Excluded from random generation">no 🎲</span>
                                    }
                                    <ItemDescription Text="@recipe.Description" />
                                </td>
                                <td class="num">@recipe.Servings.ToString("0.##")</td>
                                <td class="num">@recipe.Ingredients.Count</td>
                                <td class="num">@(view.Calories?.ToString("N0") ?? "—")</td>
                                <td class="num">@FormatNutrient(view, "protein")</td>
                                <td class="num">@FormatNutrient(view, "carbs")</td>
                                <td class="num">@FormatNutrient(view, "fat")</td>
                                <td class="actions">
                                    <button class="btn btn-sm btn-accent" title="Add an ingredient to this recipe" @onclick="() => StartAddIngredient(recipe)">+ Ingredient</button>
                                    <button class="btn btn-sm" @onclick="() => StartEditRecipe(recipe)">Edit</button>
                                    <ConfirmButton OnConfirm="() => DeleteRecipeAsync(recipe.Name)" />
                                </td>
                            </tr>
                            @if (expanded)
                            {
                                <tr class="sub-row" @key="@(recipe.Name + "#ingredients")">
                                    <td></td>
                                    <td colspan="8">
                                        @if (recipe.Ingredients.Count == 0 && !IsAddingIngredientTo(recipe))
                                        {
                                            <p class="muted small">No ingredients yet — use “+ Ingredient” to add the first one.</p>
                                        }
                                        @if (recipe.Ingredients.Count > 0)
                                        {
                                            <table class="data-table sub-table">
                                                <thead>
                                                    <tr>
                                                        <th>Ingredient</th>
                                                        <th class="num">Amount</th>
                                                        <th class="num">Calories</th>
                                                        <th class="num">Protein</th>
                                                        <th class="num">Carbs</th>
                                                        <th class="num">Fat</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var (ing, i) in recipe.Ingredients.Select((x, i) => (x, i)))
                                                    {
                                                        @if (IsEditingIngredient(recipe, i))
                                                        {
                                                            <tr class="editor-row" @key="ing">
                                                                <td colspan="7">
                                                                    <IngredientForm Ingredient="_ing" Title="@($"Edit “{_ingOriginalName}”")" SaveLabel="Save ingredient"
                                                                                    Error="@_ingError" OnSave="SaveIngredientAsync" OnCancel="CancelIngredient" />
                                                                </td>
                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            <tr @key="ing">
                                                                <td><span class="item-name">@ing.Name</span></td>
                                                                <td class="num">@ing.AmountDisplay</td>
                                                                <td class="num">@(ing.Calories?.ToString("N0") ?? "—")</td>
                                                                <td class="num">@(ing.Nutrient("protein")?.ToString("0.#") ?? "—")</td>
                                                                <td class="num">@(ing.Nutrient("carbs")?.ToString("0.#") ?? "—")</td>
                                                                <td class="num">@(ing.Nutrient("fat")?.ToString("0.#") ?? "—")</td>
                                                                <td class="actions">
                                                                    <button class="btn btn-sm" @onclick="() => StartEditIngredient(recipe, i)">Edit</button>
                                                                    <ConfirmButton Label="✕" OnConfirm="() => DeleteIngredientAsync(recipe.Name, i)" />
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr class="totals-line">
                                                        <td>Whole recipe</td>
                                                        <td class="num muted">—</td>
                                                        <td class="num total-accent">@(recipe.TotalCalories()?.ToString("N0") ?? "—")</td>
                                                        <td class="num">@(recipe.TotalNutrients().TryGetValue("protein", out var tp) ? tp.ToString("0.#") : "—")</td>
                                                        <td class="num">@(recipe.TotalNutrients().TryGetValue("carbs", out var tc) ? tc.ToString("0.#") : "—")</td>
                                                        <td class="num">@(recipe.TotalNutrients().TryGetValue("fat", out var tf) ? tf.ToString("0.#") : "—")</td>
                                                        <td></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        }
                                        @if (IsAddingIngredientTo(recipe))
                                        {
                                            <div class="editor-card inline-editor">
                                                <IngredientForm Ingredient="_ing" Title="@($"Add ingredient to “{recipe.Name}”")" SaveLabel="Add to recipe"
                                                                Error="@_ingError" OnSave="SaveIngredientAsync" OnCancel="CancelIngredient" />
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="muted small">Per-serving values — schedule a recipe like any other item; one serving is 1/N of the whole recipe.</p>
    }
}