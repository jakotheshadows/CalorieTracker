@page "/foods"
@implements IDisposable
@inject AppState State

<PageTitle>Menu Items</PageTitle>

<div class="page-header">
    <h1>Menu Items</h1>
    @if (_tab == Tab.Items)
    {
        <button class="btn btn-accent" @onclick="StartAdd">+ New item</button>
    }
    else
    {
        <button class="btn btn-accent" @onclick="StartAddRecipe">+ New recipe</button>
    }
</div>

<div class="tab-bar">
    <button class="btn @(_tab == Tab.Items ? "btn-accent" : "")" @onclick="() => _tab = Tab.Items">Items</button>
    <button class="btn @(_tab == Tab.Recipes ? "btn-accent" : "")" @onclick="() => _tab = Tab.Recipes">Recipes@(State.Data.Recipes.Count > 0 ? $" ({State.Data.Recipes.Count})" : "")</button>
</div>

<div class="toolbar">
    <input class="input search" placeholder="@(_tab == Tab.Items ? "Search items…" : "Search recipes…")" @bind="_search" @bind:event="oninput" />
    @if (_tab == Tab.Items)
    {
        <select class="input" @bind="_categoryFilter">
            <option value="">All categories</option>
            <option value="Food">Food</option>
            <option value="Beverage">Beverage</option>
            <option value="Snack">Snack</option>
        </select>
    }
</div>

@if (_tab == Tab.Items)
{
    var items = Filtered().ToList();
    @if (State.Data.Items.Count == 0)
    {
        <div class="card empty-state">
            <p>No menu items yet. Add the foods, beverages, and snacks you eat — only a name is required.</p>
            <p class="muted small">Tip: the 🔎 Search USDA button in the editor can auto-fill calories, macros, and micros from the USDA food database.</p>
        </div>
    }
    else if (items.Count == 0)
    {
        <div class="card empty-state"><p class="muted">No items match your search.</p></div>
    }
    else
    {
        <div class="card table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Serving</th>
                        <th class="num">Calories</th>
                        <th class="num">Protein</th>
                        <th class="num">Carbs</th>
                        <th class="num">Fat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>
                                <span class="item-name">@item.Name</span>
                                @if (item.ExcludeFromRandom)
                                {
                                    <span class="badge badge-norand" title="Excluded from random generation">no 🎲</span>
                                }
                                <ItemDescription Text="@item.Description" />
                            </td>
                            <td><span class="badge badge-@item.Category.ToString().ToLowerInvariant()">@item.Category</span></td>
                            <td class="muted">@(item.ServingSize ?? "—")</td>
                            <td class="num">@(item.Calories?.ToString("N0") ?? "—")</td>
                            <td class="num">@FormatNutrient(item, "protein")</td>
                            <td class="num">@FormatNutrient(item, "carbs")</td>
                            <td class="num">@FormatNutrient(item, "fat")</td>
                            <td class="actions">
                                <button class="btn btn-sm" @onclick="() => StartEdit(item)">Edit</button>
                                @if (_confirmDelete == item.Name)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(item.Name)">Confirm?</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-ghost-danger" @onclick="() => _confirmDelete = item.Name">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    var recipes = FilteredRecipes().ToList();
    @if (State.Data.Recipes.Count == 0)
    {
        <div class="card empty-state">
            <p>No recipes yet. A recipe is a set of ingredients with amounts — CalTrack totals the nutrition and divides it into servings.</p>
            <p class="muted small">Once saved, a recipe can be scheduled just like any other menu item (one serving at a time).</p>
        </div>
    }
    else if (recipes.Count == 0)
    {
        <div class="card empty-state"><p class="muted">No recipes match your search.</p></div>
    }
    else
    {
        <div class="card table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="num">Servings</th>
                        <th class="num">Ingredients</th>
                        <th class="num">Calories<span class="muted small"> /serv</span></th>
                        <th class="num">Protein</th>
                        <th class="num">Carbs</th>
                        <th class="num">Fat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var recipe in recipes)
                    {
                        var view = recipe.ToMenuItem();
                        <tr>
                            <td>
                                <span class="item-name">@recipe.Name</span>
                                @if (recipe.ExcludeFromRandom)
                                {
                                    <span class="badge badge-norand" title="Excluded from random generation">no 🎲</span>
                                }
                                <ItemDescription Text="@recipe.Description" />
                            </td>
                            <td class="num">@recipe.Servings.ToString("0.##")</td>
                            <td class="num">@recipe.Ingredients.Count</td>
                            <td class="num">@(view.Calories?.ToString("N0") ?? "—")</td>
                            <td class="num">@FormatNutrient(view, "protein")</td>
                            <td class="num">@FormatNutrient(view, "carbs")</td>
                            <td class="num">@FormatNutrient(view, "fat")</td>
                            <td class="actions">
                                <button class="btn btn-sm" @onclick="() => StartEditRecipe(recipe)">Edit</button>
                                @if (_confirmDelete == recipe.Name)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteRecipeAsync(recipe.Name)">Confirm?</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-ghost-danger" @onclick="() => _confirmDelete = recipe.Name">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted small">Per-serving values — schedule a recipe like any other item; one serving is 1/N of the whole recipe.</p>
    }
}

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="CancelEdit">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <h2>@(_originalName is null ? "New menu item" : $"Edit “{_originalName}”")</h2>

            @if (_error is not null)
            {
                <div class="alert-error">@_error</div>
            }

            <div class="form-grid">
                <label class="field span-2">
                    <span>Name <b class="req">*</b></span>
                    <div class="name-row">
                        <input class="input" @bind="_editing.Name" placeholder="e.g. Grilled chicken breast" />
                        <button class="btn" type="button" title="Auto-fill nutrition facts from the USDA food database" @onclick="() => _usdaOpen = true">🔎 Search USDA</button>
                    </div>
                </label>
                <label class="field">
                    <span>Category</span>
                    <select class="input" @bind="_editing.Category">
                        <option value="@FoodCategory.Food">Food</option>
                        <option value="@FoodCategory.Beverage">Beverage</option>
                        <option value="@FoodCategory.Snack">Snack</option>
                    </select>
                </label>
                <label class="field">
                    <span>Serving size</span>
                    <input class="input" @bind="_editing.ServingSize" placeholder="e.g. 6 oz / 170 g" />
                </label>
                <label class="field span-2">
                    <span>Description</span>
                    <textarea class="input" rows="2" @bind="_editing.Description" placeholder="Optional notes"></textarea>
                </label>
                <label class="field">
                    <span>Calories (kcal)</span>
                    <input class="input" type="number" step="any" min="0" @bind="_editing.Calories" />
                </label>
                <label class="field checkbox-field">
                    <input type="checkbox" @bind="_editing.ExcludeFromRandom" />
                    <span>Exclude from randomize</span>
                </label>
            </div>

            @if (_usdaOpen)
            {
                <UsdaPanel InitialQuery="@_editing.Name" OnApplied="OnItemUsdaApplied" OnClose="() => _usdaOpen = false" />
            }

            <h4 class="section-label">Macronutrients <span class="muted small">(per serving, optional)</span></h4>
            <div class="form-grid nutrients-grid">
                @foreach (var def in NutrientCatalog.Macros)
                {
                    <label class="field" @key="def.Key">
                        <span>@def.Label (@def.Unit)</span>
                        <input class="input" type="number" step="any" min="0"
                               value="@NutrientValue(def.Key)"
                               @onchange="e => SetNutrient(def.Key, e.Value?.ToString())" />
                    </label>
                }
            </div>

            <details class="micros-details" open="@_microsOpen">
                <summary @onclick="() => _microsOpen = !_microsOpen" @onclick:preventDefault="true">
                    Micronutrients <span class="muted small">(per serving, optional)</span>
                </summary>
                <div class="form-grid nutrients-grid">
                    @foreach (var def in NutrientCatalog.Micros)
                    {
                        <label class="field" @key="def.Key">
                            <span>@def.Label (@def.Unit)</span>
                            <input class="input" type="number" step="any" min="0"
                                   value="@NutrientValue(def.Key)"
                                   @onchange="e => SetNutrient(def.Key, e.Value?.ToString())" />
                        </label>
                    }
                </div>
            </details>

            <div class="btn-row modal-actions">
                <button class="btn btn-accent" @onclick="SaveAsync">Save</button>
                <button class="btn" @onclick="CancelEdit">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_recipe is not null)
{
    <div class="modal-backdrop" @onclick="CancelRecipe">
        <div class="modal-panel modal-wide" @onclick:stopPropagation="true">
            <h2>@(_recipeOriginalName is null ? "New recipe" : $"Edit “{_recipeOriginalName}”")</h2>

            @if (_recipeError is not null)
            {
                <div class="alert-error">@_recipeError</div>
            }

            <div class="form-grid">
                <label class="field span-2">
                    <span>Name <b class="req">*</b></span>
                    <input class="input" @bind="_recipe.Name" placeholder="e.g. Turkey chili" />
                </label>
                <label class="field">
                    <span>Makes (servings) <b class="req">*</b></span>
                    <input class="input" type="number" step="any" min="0.25" @bind="_recipe.Servings" />
                </label>
                <label class="field checkbox-field">
                    <input type="checkbox" @bind="_recipe.ExcludeFromRandom" />
                    <span>Exclude from randomize</span>
                </label>
                <label class="field span-2">
                    <span>Description</span>
                    <textarea class="input" rows="2" @bind="_recipe.Description" placeholder="Optional notes"></textarea>
                </label>
            </div>

            <h4 class="section-label">Ingredients</h4>
            @if (_recipe.Ingredients.Count == 0)
            {
                <p class="muted small">No ingredients yet — add the first one below.</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Ingredient</th>
                            <th class="num">Amount</th>
                            <th class="num">Calories</th>
                            <th class="num">Protein</th>
                            <th class="num">Carbs</th>
                            <th class="num">Fat</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (ing, i) in _recipe.Ingredients.Select((x, i) => (x, i)))
                        {
                            <tr @key="ing">
                                <td><span class="item-name">@ing.Name</span></td>
                                <td class="num">@ing.AmountDisplay</td>
                                <td class="num">@(ing.Calories?.ToString("N0") ?? "—")</td>
                                <td class="num">@(ing.Nutrient("protein")?.ToString("0.#") ?? "—")</td>
                                <td class="num">@(ing.Nutrient("carbs")?.ToString("0.#") ?? "—")</td>
                                <td class="num">@(ing.Nutrient("fat")?.ToString("0.#") ?? "—")</td>
                                <td class="actions">
                                    <button class="btn btn-sm" @onclick="() => EditIngredient(i)">Edit</button>
                                    <button class="btn btn-sm btn-ghost-danger" @onclick="() => RemoveIngredient(i)">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="ing-form">
                <h4 class="section-label">@(_ingIndex is null ? "Add ingredient" : $"Edit “{_recipe.Ingredients[_ingIndex.Value].Name}”")</h4>
                @if (_ingError is not null)
                {
                    <div class="alert-error">@_ingError</div>
                }
                <div class="form-grid">
                    <label class="field span-2">
                        <span>Ingredient <b class="req">*</b></span>
                        <div class="name-row">
                            <input class="input" @bind="_ing.Name" placeholder="e.g. Ground turkey" />
                            <button class="btn" type="button" title="Auto-fill nutrition from the USDA food database" @onclick="() => _ingUsdaOpen = true">🔎 Search USDA</button>
                        </div>
                    </label>
                    <label class="field">
                        <span>Amount <b class="req">*</b></span>
                        <div class="input-pair">
                            <input class="input" type="number" step="any" min="0" @bind="_ing.Amount" />
                            <select class="input" @bind="_ing.Unit">
                                @foreach (var unit in Units.Mass.Concat(Units.Volume))
                                {
                                    <option value="@unit">@unit</option>
                                }
                            </select>
                        </div>
                    </label>
                    <label class="field">
                        <span>Calories (kcal)</span>
                        <input class="input" type="number" step="any" min="0"
                               value="@IngCalories()"
                               @onchange="e => SetIngCalories(e.Value?.ToString())" />
                    </label>
                </div>

                @if (_ingUsdaOpen)
                {
                    <UsdaPanel InitialQuery="@_ing.Name" OnApplied="OnIngredientUsdaApplied" OnClose="() => _ingUsdaOpen = false" />
                }

                <h4 class="section-label">Macronutrients <span class="muted small">(for this amount, optional)</span></h4>
                <div class="form-grid nutrients-grid">
                    @foreach (var def in NutrientCatalog.Macros)
                    {
                        <label class="field" @key="def.Key">
                            <span>@def.Label (@def.Unit)</span>
                            <input class="input" type="number" step="any" min="0"
                                   value="@IngNutrientValue(def.Key)"
                                   @onchange="e => SetIngNutrient(def.Key, e.Value?.ToString())" />
                        </label>
                    }
                </div>

                <details class="micros-details" open="@_ingMicrosOpen">
                    <summary @onclick="() => _ingMicrosOpen = !_ingMicrosOpen" @onclick:preventDefault="true">
                        Micronutrients <span class="muted small">(for this amount, optional)</span>
                    </summary>
                    <div class="form-grid nutrients-grid">
                        @foreach (var def in NutrientCatalog.Micros)
                        {
                            <label class="field" @key="def.Key">
                                <span>@def.Label (@def.Unit)</span>
                                <input class="input" type="number" step="any" min="0"
                                       value="@IngNutrientValue(def.Key)"
                                       @onchange="e => SetIngNutrient(def.Key, e.Value?.ToString())" />
                            </label>
                        }
                    </div>
                </details>

                <div class="btn-row">
                    <button class="btn btn-accent" @onclick="AddOrUpdateIngredient">@(_ingIndex is null ? "＋ Add to recipe" : "Update ingredient")</button>
                    @if (_ingIndex is not null || !string.IsNullOrWhiteSpace(_ing.Name))
                    {
                        <button class="btn" @onclick="ResetIngredientForm">Cancel</button>
                    }
                </div>
            </div>

            @if (_recipe.Ingredients.Count > 0)
            {
                var total = _recipe.TotalCalories();
                var perServing = _recipe.PerServingCalories();
                var nutrients = _recipe.TotalNutrients();
                var servings = _recipe.Servings > 0 ? _recipe.Servings : 1;
                <h4 class="section-label">Recipe nutrition</h4>
                <table class="data-table recipe-totals">
                    <thead>
                        <tr>
                            <th></th>
                            <th class="num">Whole recipe</th>
                            <th class="num">Per serving <span class="muted small">(of @servings.ToString("0.##"))</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Calories (kcal)</td>
                            <td class="num">@(total?.ToString("N0") ?? "—")</td>
                            <td class="num total-accent">@(perServing?.ToString("N0") ?? "—")</td>
                        </tr>
                        @foreach (var def in NutrientCatalog.All)
                        {
                            if (nutrients.TryGetValue(def.Key, out var v))
                            {
                                <tr>
                                    <td>@def.Label (@def.Unit)</td>
                                    <td class="num">@v.ToString("0.#")</td>
                                    <td class="num">@((v / servings).ToString("0.#"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }

            <div class="btn-row modal-actions">
                <button class="btn btn-accent" @onclick="SaveRecipeAsync">Save recipe</button>
                <button class="btn" @onclick="CancelRecipe">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private enum Tab { Items, Recipes }

    private Tab _tab = Tab.Items;
    private string _search = "";
    private string _categoryFilter = "";
    private string? _confirmDelete;

    private FoodItem? _editing;
    private string? _originalName;
    private string? _error;
    private bool _microsOpen;
    private bool _usdaOpen;

    private Recipe? _recipe;
    private string? _recipeOriginalName;
    private string? _recipeError;
    private RecipeIngredient _ing = new();
    private int? _ingIndex;
    private string? _ingError;
    private bool _ingMicrosOpen;
    private bool _ingUsdaOpen;
    private int? _ingUsdaFdcId;

    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;

    private IEnumerable<FoodItem> Filtered()
    {
        var q = State.Data.Items.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(i => i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                          || (i.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
        if (Enum.TryParse<FoodCategory>(_categoryFilter, out var cat))
            q = q.Where(i => i.Category == cat);
        return q;
    }

    private IEnumerable<Recipe> FilteredRecipes()
    {
        var q = State.Data.Recipes.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(r => r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                          || (r.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                          || r.Ingredients.Any(i => i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)));
        return q;
    }

    private static string FormatNutrient(FoodItem item, string key)
    {
        var v = item.Nutrient(key);
        return v is null ? "—" : v.Value.ToString("0.#");
    }

    // ---------- Item editor ----------

    private void StartAdd()
    {
        _editing = new FoodItem();
        _originalName = null;
        _error = null;
        _microsOpen = false;
        _usdaOpen = false;
    }

    private void StartEdit(FoodItem item)
    {
        _editing = item.Clone();
        _originalName = item.Name;
        _error = null;
        _microsOpen = NutrientCatalog.Micros.Any(m => item.Nutrients.ContainsKey(m.Key));
        _usdaOpen = false;
    }

    private void CancelEdit()
    {
        _editing = null;
        _error = null;
        _usdaOpen = false;
    }

    private void OnItemUsdaApplied(UsdaApplied a)
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name)) _editing.Name = a.Food.Description;
        _editing.ServingSize = a.ServingText;
        _editing.Calories = a.Food.CaloriesFor(a.AmountInBase);
        _editing.Nutrients = a.Food.NutrientsFor(a.AmountInBase);
        _microsOpen = NutrientCatalog.Micros.Any(m => _editing.Nutrients.ContainsKey(m.Key));
    }

    private string? NutrientValue(string key)
    {
        var v = _editing?.Nutrient(key);
        return v?.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private void SetNutrient(string key, string? raw)
    {
        if (_editing is null) return;
        if (double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v))
            _editing.Nutrients[key] = v;
        else
            _editing.Nutrients.Remove(key);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _error = await State.UpsertItemAsync(_editing, _originalName);
        if (_error is null) CancelEdit();
    }

    private async Task DeleteAsync(string name)
    {
        _confirmDelete = null;
        await State.DeleteItemAsync(name);
    }

    // ---------- Recipe editor ----------

    private void StartAddRecipe()
    {
        _recipe = new Recipe();
        _recipeOriginalName = null;
        _recipeError = null;
        ResetIngredientForm();
    }

    private void StartEditRecipe(Recipe recipe)
    {
        _recipe = recipe.Clone();
        _recipeOriginalName = recipe.Name;
        _recipeError = null;
        ResetIngredientForm();
    }

    private void CancelRecipe()
    {
        _recipe = null;
        _recipeError = null;
        ResetIngredientForm();
    }

    private void ResetIngredientForm()
    {
        _ing = new RecipeIngredient();
        _ingIndex = null;
        _ingError = null;
        _ingMicrosOpen = false;
        _ingUsdaOpen = false;
        _ingUsdaFdcId = null;
    }

    private void EditIngredient(int index)
    {
        if (_recipe is null) return;
        _ing = _recipe.Ingredients[index].Clone();
        _ingIndex = index;
        _ingError = null;
        _ingMicrosOpen = NutrientCatalog.Micros.Any(m => _ing.NutrientsPer100.ContainsKey(m.Key));
        _ingUsdaOpen = false;
        _ingUsdaFdcId = null;
    }

    private void RemoveIngredient(int index)
    {
        if (_recipe is null) return;
        _recipe.Ingredients.RemoveAt(index);
        if (_ingIndex == index) ResetIngredientForm();
        else if (_ingIndex > index) _ingIndex--;
    }

    /// <summary>Validate the ingredient form and commit it to the recipe. Null on success.</summary>
    private string? CommitIngredient()
    {
        if (_recipe is null) return "No recipe open.";
        var name = _ing.Name?.Trim() ?? "";
        if (name.Length == 0) return "Ingredient name is required.";
        if (_ing.AmountInBase is null) return "Enter an amount greater than zero.";
        _ing.Name = name;

        if (_ingIndex is { } idx) _recipe.Ingredients[idx] = _ing;
        else _recipe.Ingredients.Add(_ing);
        ResetIngredientForm();
        return null;
    }

    private void AddOrUpdateIngredient() => _ingError = CommitIngredient();

    private void OnIngredientUsdaApplied(UsdaApplied a)
    {
        // Fill the name when a result is picked; a later serving rescale of the same
        // food must not clobber a hand-edited name.
        if (a.Food.FdcId != _ingUsdaFdcId)
        {
            _ing.Name = a.Food.Description;
            _ingUsdaFdcId = a.Food.FdcId;
        }
        _ing.Amount = a.Amount;
        _ing.Unit = a.Unit;
        _ing.CaloriesPer100 = a.Food.CaloriesPer100;
        _ing.NutrientsPer100 = new Dictionary<string, double>(a.Food.NutrientsPer100);
        _ingMicrosOpen = NutrientCatalog.Micros.Any(m => _ing.NutrientsPer100.ContainsKey(m.Key));
        _ingError = null;
    }

    private string? IngCalories() =>
        _ing.Calories?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void SetIngCalories(string? raw)
    {
        if (!double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            _ing.CaloriesPer100 = null;
            return;
        }
        if (_ing.AmountInBase is { } b) _ing.CaloriesPer100 = v * 100.0 / b;
        else _ingError = "Enter the amount first — nutrition is stored per unit of weight.";
    }

    private string? IngNutrientValue(string key) =>
        _ing.Nutrient(key)?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void SetIngNutrient(string key, string? raw)
    {
        if (!double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            _ing.NutrientsPer100.Remove(key);
            return;
        }
        if (_ing.AmountInBase is { } b) _ing.NutrientsPer100[key] = v * 100.0 / b;
        else _ingError = "Enter the amount first — nutrition is stored per unit of weight.";
    }

    private async Task SaveRecipeAsync()
    {
        if (_recipe is null) return;
        // Commit a half-filled ingredient form so its data isn't silently lost.
        if (!string.IsNullOrWhiteSpace(_ing.Name))
        {
            _ingError = CommitIngredient();
            if (_ingError is not null) return;
        }
        _recipeError = await State.UpsertRecipeAsync(_recipe, _recipeOriginalName);
        if (_recipeError is null) CancelRecipe();
    }

    private async Task DeleteRecipeAsync(string name)
    {
        _confirmDelete = null;
        await State.DeleteRecipeAsync(name);
    }
}
