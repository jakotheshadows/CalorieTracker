@page "/schedule"
@implements IDisposable
@inject AppState State

<PageTitle>Schedule</PageTitle>

<div class="page-header">
    <h1>Schedule</h1>
    <div class="view-switch">
        <button class="btn @(_view == ViewMode.Day ? "btn-accent" : "")" @onclick="() => _view = ViewMode.Day">Day</button>
        <button class="btn @(_view == ViewMode.Week ? "btn-accent" : "")" @onclick="() => _view = ViewMode.Week">Week</button>
        <button class="btn @(_view == ViewMode.Month ? "btn-accent" : "")" @onclick="() => _view = ViewMode.Month">Month</button>
    </div>
</div>

<div class="toolbar">
    <button class="btn" @onclick="() => Navigate(-1)">‹ Prev</button>
    <button class="btn" @onclick="GoToday">Today</button>
    <button class="btn" @onclick="() => Navigate(1)">Next ›</button>
    <span class="range-label">@RangeLabel()</span>
    <span class="spacer"></span>
    <button class="btn btn-accent" @onclick="OpenRandomize">🎲 Randomize…</button>
</div>

@if (_randOpen)
{
    <div class="card editor-card rand-card">
        <div class="card-head-row">
            <h3>🎲 Randomize schedule</h3>
            <span class="spacer"></span>
            <button class="btn" @onclick="() => _randOpen = false">Close</button>
        </div>
        <p class="muted small">
            Fills each day in the range with random menu items. The calorie target is a daily
            <b>cap</b> (tolerance sets how far a day may go over it); macro/micro targets are
            daily <b>minimums</b>. Only items and recipes with calories &gt; 0 that aren't marked
            “exclude from randomize” are used.
            <b>@State.AllMenuItems().Count(AppState.IsRandomEligible)</b> of @(State.Data.Items.Count + State.Data.Recipes.Count) menu items and recipes are eligible.
        </p>

        @if (_randError is not null)
        {
            <div class="alert-error">@_randError</div>
        }
        @if (_randDone)
        {
            <div class="alert-ok">Schedule generated!</div>
        }
        @if (_randWarning is not null)
        {
            <div class="alert-warn">@_randWarning</div>
        }

        <div class="form-grid">
            <label class="field">
                <span>From</span>
                <input class="input" type="date" @bind="_randStart" />
            </label>
            <label class="field">
                <span>To</span>
                <input class="input" type="date" @bind="_randEnd" />
            </label>
            <label class="field">
                <span>Calories / day <b class="req">*</b></span>
                <input class="input" type="number" step="any" min="1" @bind="_targets.Calories" />
                @if (_randFromGoal)
                {
                    <span class="muted tiny">Prefilled from your goal target 🎯</span>
                }
            </label>
            <label class="field">
                <span>Tolerance (±%)</span>
                <input class="input" type="number" step="any" min="1" max="50" @bind="_targets.TolerancePercent" />
            </label>
            <label class="field">
                <span>Items per day (min)</span>
                <input class="input" type="number" min="1" max="12" @bind="_targets.MinItemsPerDay" />
            </label>
            <label class="field">
                <span>Items per day (max)</span>
                <input class="input" type="number" min="1" max="12" @bind="_targets.MaxItemsPerDay" />
            </label>
            <label class="field">
                <span>Max servings per item</span>
                <input class="input" type="number" min="1" max="10" @bind="_targets.MaxServingsPerItem" />
            </label>
            <label class="field checkbox-field">
                <input type="checkbox" @bind="_randOverwrite" />
                <span>Overwrite days that already have a plan</span>
            </label>
        </div>

        <NutrientFields MacrosLabel="Macro targets / day" MicrosLabel="Micronutrient targets / day"
                        GetValue="TargetValue" SetValue="SetTarget" />

        <div class="btn-row editor-actions">
            <button class="btn btn-accent" @onclick="RunRandomizeAsync">Generate</button>
            <button class="btn" @onclick="() => _randOpen = false">Close</button>
        </div>
    </div>
}

<div class="sched-layout">
    <div class="sched-main">
        @if (_view == ViewMode.Day)
        {
            var entries = State.GetDay(_date);
            <div class="card">
                <h3>@_date.ToString("dddd, MMMM d")</h3>

                @if (entries.Count == 0)
                {
                    <p class="muted">Nothing planned. Add items below or use Randomize.</p>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="num">Servings</th>
                                <th class="num">Calories</th>
                                <th class="num">Protein</th>
                                <th class="num">Carbs</th>
                                <th class="num">Fat</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in entries.ToList())
                            {
                                @if (_adhocEntry == entry && _adhocItem is not null)
                                {
                                    <tr class="editor-row" @key="entry">
                                        <td colspan="7">
                                            <ItemForm Item="_adhocItem" Title="@($"Edit “{entry.ItemName}”")" SaveLabel="Save" Error="@_adhocError"
                                                      OnSave="SaveAdHocAsync" OnCancel="CancelAdHoc">
                                                <ExtraFields>
                                                    <label class="field checkbox-field">
                                                        <input type="checkbox" @bind="_adhocSaveToMenu" />
                                                        <span>Also save to my menu items</span>
                                                    </label>
                                                </ExtraFields>
                                            </ItemForm>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    var item = State.ResolveEntry(entry);
                                    <tr @key="entry">
                                        <td>
                                            <span class="item-name">@entry.ItemName</span>
                                            @if (entry.AdHoc is not null)
                                            {
                                                <span class="badge badge-adhoc" title="One-off entry — not in your menu items">one-off</span>
                                            }
                                            @if (item?.ServingSize is not null)
                                            {
                                                <span class="muted small"> · @item.ServingSize</span>
                                            }
                                            @if (item is null)
                                            {
                                                <span class="badge badge-warn">missing item</span>
                                            }
                                        </td>
                                        <td class="num servings-cell">
                                            <input class="input input-sm num" type="number" step="0.5" min="0"
                                                   value="@entry.Servings"
                                                   @onchange="e => OnServingsChanged(entry, e.Value?.ToString())" />
                                        </td>
                                        <td class="num">@(item?.Calories is null ? "—" : (item.Calories.Value * entry.Servings).ToString("N0"))</td>
                                        <td class="num">@EntryMacro(item, "protein", entry.Servings)</td>
                                        <td class="num">@EntryMacro(item, "carbs", entry.Servings)</td>
                                        <td class="num">@EntryMacro(item, "fat", entry.Servings)</td>
                                        <td class="actions">
                                            @if (entry.AdHoc is not null)
                                            {
                                                <button class="btn btn-sm" @onclick="() => StartEditAdHoc(entry)">Edit</button>
                                            }
                                            <button class="btn btn-sm btn-ghost-danger" @onclick="() => State.RemoveEntryAsync(_date, entry)">✕</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }

                <div class="add-entry-row">
                    <select class="input" @bind="_addItemName">
                        <option value="">— pick a menu item —</option>
                        @if (State.Data.Recipes.Count == 0)
                        {
                            @foreach (var item in State.Data.Items)
                            {
                                <option value="@item.Name">@item.Name @(item.Calories is null ? "" : $"({item.Calories:N0} kcal)")</option>
                            }
                        }
                        else
                        {
                            <optgroup label="Menu items">
                                @foreach (var item in State.Data.Items)
                                {
                                    <option value="@item.Name">@item.Name @(item.Calories is null ? "" : $"({item.Calories:N0} kcal)")</option>
                                }
                            </optgroup>
                            <optgroup label="Recipes (per serving)">
                                @foreach (var recipe in State.Data.Recipes)
                                {
                                    <option value="@recipe.Name">@recipe.Name @(recipe.PerServingCalories() is { } kcal ? $"({kcal:N0} kcal)" : "")</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <input class="input input-sm num" type="number" step="0.5" min="0.5" @bind="_addServings" />
                    <button class="btn btn-accent" disabled="@(string.IsNullOrEmpty(_addItemName))" @onclick="AddEntryAsync">Add</button>
                    <button class="btn" title="Add something that isn't in your menu items" @onclick="StartAddAdHoc">+ One-off</button>
                    @if (entries.Count > 0)
                    {
                        <span class="spacer"></span>
                        <button class="btn btn-ghost-danger" @onclick="() => State.ClearDayAsync(_date)">Clear day</button>
                    }
                </div>

                @if (_adhocItem is not null && _adhocEntry is null)
                {
                    <div class="inline-editor">
                        <ItemForm Item="_adhocItem" Title="@($"One-off item for {_date:dddd, MMM d}")" SaveLabel="Add to day" Error="@_adhocError"
                                  OnSave="SaveAdHocAsync" OnCancel="CancelAdHoc">
                            <ExtraFields>
                                <label class="field">
                                    <span>Servings</span>
                                    <input class="input" type="number" step="0.5" min="0.5" @bind="_adhocServings" />
                                </label>
                                <label class="field checkbox-field">
                                    <input type="checkbox" @bind="_adhocSaveToMenu" />
                                    <span>Also save to my menu items</span>
                                </label>
                            </ExtraFields>
                        </ItemForm>
                    </div>
                }

                <div class="template-row">
                    @if (State.TemplateNames.Any())
                    {
                        <select class="input" @bind="_templateSel">
                            <option value="">— day templates —</option>
                            @foreach (var t in State.TemplateNames)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                        <button class="btn" disabled="@(_templateSel == "")" @onclick="ApplyTemplateAsync">Apply to this day</button>
                        @if (_templateSel != "")
                        {
                            @if (_templateToDelete == _templateSel)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="DeleteTemplateAsync">Confirm delete?</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-ghost-danger" @onclick="() => _templateToDelete = _templateSel">Delete</button>
                            }
                        }
                    }
                    <span class="spacer"></span>
                    @if (entries.Count > 0)
                    {
                        @if (_savingTemplate)
                        {
                            <input class="input template-name-input" placeholder="Template name"
                                   @bind="_newTemplateName" @bind:event="oninput" />
                            <button class="btn btn-accent btn-sm" disabled="@(string.IsNullOrWhiteSpace(_newTemplateName))" @onclick="SaveTemplateAsync">Save</button>
                            <button class="btn btn-sm" @onclick="CancelSaveTemplate">Cancel</button>
                        }
                        else
                        {
                            <button class="btn" @onclick="StartSaveTemplate">💾 Save day as template</button>
                        }
                    }
                </div>
                @if (_templateError is not null)
                {
                    <div class="alert-error template-alert">@_templateError</div>
                }
                @if (_confirmOverwrite)
                {
                    <div class="alert-warn template-alert">
                        A template named “@_newTemplateName.Trim()” already exists.
                        Replace it with this day's current plan?
                        <div class="btn-row">
                            <button class="btn btn-sm btn-accent" @onclick="ConfirmOverwriteAsync">Overwrite</button>
                            <button class="btn btn-sm" @onclick="() => _confirmOverwrite = false">Cancel</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_view == ViewMode.Week)
        {
            var ws = AppState.WeekStart(_date);
            <div class="week-grid">
                @for (var i = 0; i < 7; i++)
                {
                    var day = ws.AddDays(i);
                    var entries = State.GetDay(day);
                    var totals = State.TotalsForDay(day);
                    <div class="card day-card @(day == Today ? "today" : "")" @onclick="() => OpenDay(day)">
                        <div class="day-card-head">
                            <span>@day.ToString("ddd d")</span>
                            <span class="num muted">@(entries.Count == 0 ? "" : totals.Calories.ToString("N0") + " kcal")</span>
                        </div>
                        @if (entries.Count == 0)
                        {
                            <div class="muted small">—</div>
                        }
                        else
                        {
                            <ul class="mini-list">
                                @foreach (var e in entries)
                                {
                                    <li>@e.ItemName <span class="muted">×@e.Servings.ToString("0.##")</span></li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            var first = new DateOnly(_date.Year, _date.Month, 1);
            var gridStart = AppState.WeekStart(first);
            <div class="card month-card">
                <div class="month-grid">
                    @foreach (var dow in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                    {
                        <div class="month-dow">@dow</div>
                    }
                    @for (var i = 0; i < 42; i++)
                    {
                        var day = gridStart.AddDays(i);
                        var inMonth = day.Month == _date.Month;
                        var totals = State.TotalsForDay(day);
                        <div class="month-cell @(inMonth ? "" : "outside") @(day == Today ? "today" : "")"
                             @onclick="() => OpenDay(day)">
                            <span class="month-daynum">@day.Day</span>
                            @if (totals.EntryCount > 0)
                            {
                                <span class="month-kcal">@totals.Calories.ToString("N0")</span>
                                <span class="month-items muted">@totals.EntryCount item@(totals.EntryCount == 1 ? "" : "s")</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <aside class="sched-side">
        <TotalsPanel Title="@TotalsTitle()" Totals="@RangeTotals()" DayCount="@RangeDayCount()" />
        @if (State.GetGoalStatus() is { } goal)
        {
            var totals = RangeTotals();
            var plannedDays = _view == ViewMode.Day ? (totals.EntryCount > 0 ? 1 : 0) : totals.DaysWithEntries;
            var delta = totals.Calories - goal.SuggestedCalories * plannedDays;
            <div class="card goal-side">
                <h3>🎯 Goal</h3>
                <div class="goal-side-target">@goal.SuggestedCalories.ToString("N0") <span class="goal-unit">kcal / day</span></div>
                @if (plannedDays > 0)
                {
                    @if (Math.Abs(delta) <= goal.SuggestedCalories * plannedDays * 0.05)
                    {
                        var band = goal.SuggestedCalories * plannedDays * 0.05;
                        var dir = delta >= 0 ? "over" : "under";
                        <p class="small goal-delta-ok">
                            On target across @plannedDays planned day(s).
                            <span class="info-tip" tabindex="0">ⓘ<span class="tip-text">
                                “On target” means the planned total is within ±5%
                                (±@band.ToString("N0") kcal) of your target for the planned day(s).
                                This plan is @Math.Abs(delta).ToString("N0") kcal @dir the target
                                — about @((Math.Abs(delta) / plannedDays).ToString("N0")) kcal/day @dir.
                            </span></span>
                        </p>
                    }
                    else if (delta > 0)
                    {
                        <p class="small goal-delta-over">@delta.ToString("N0") kcal over target across @plannedDays planned day(s).</p>
                    }
                    else
                    {
                        <p class="small goal-delta-ok">@((-delta).ToString("N0")) kcal under target across @plannedDays planned day(s).</p>
                    }
                }
                @if (!goal.AtTarget)
                {
                    <p class="muted tiny">
                        Pace: @FormatGoalRate(goal.KgPerWeek)/week@(goal.Eta is not null ? $" · target around {goal.Eta.Value:MMM d, yyyy}" : "")
                    </p>
                }
                else
                {
                    <p class="muted tiny">Maintaining current weight.</p>
                }
            </div>
        }
    </aside>
</div>
