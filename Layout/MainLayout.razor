@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject IJSRuntime JS

<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="">🥗 <span>CalTrack</span></a>
        <nav class="topnav">
            <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="foods">Menu Items</NavLink>
            <NavLink href="schedule">Schedule</NavLink>
            <NavLink href="goals">Goals</NavLink>
            <NavLink href="settings">Settings</NavLink>
        </nav>
        <a class="about-chip" href="https://jakotheshadows.github.io/" target="_blank" rel="noopener"
           title="More projects by jakotheshadows">
            💻<span class="about-text">About me</span>
        </a>
        <a class="coffee-chip" href="https://buymeacoffee.com/jakotheshadows" target="_blank" rel="noopener"
           title="CalTrack is free — buy me a coffee if you'd like to support it">
            ☕<span class="coffee-text">Buy me a coffee</span>
        </a>
    </header>

    <main class="page-main">
        @if (State.Folder == FolderState.NeedsReconnect)
        {
            <div class="folder-banner">
                <span>⚠ CalTrack needs your OK to keep using your data folder <b>@State.FolderName</b>. Changes are kept in this browser until then.</span>
                <button class="btn btn-accent btn-sm" @onclick="ReconnectFolderAsync">Reconnect folder</button>
            </div>
        }
        @Body
    </main>

    @if (_toasts.Count > 0)
    {
        <div class="sync-toasts" role="status" aria-live="polite">
            @foreach (var toast in _toasts)
            {
                <div class="sync-toast" @key="toast">@toast.Text</div>
            }
        </div>
    }

    @if (_updateAvailable)
    {
        <div class="update-toast">
            @if (_updating)
            {
                <span class="spinner"></span>
                <span>Updating CalTrack… the app will reload in a moment.</span>
            }
            else
            {
                <span>✨ A new version of CalTrack is ready.</span>
                <button class="btn btn-accent btn-sm" @onclick="ApplyUpdateAsync">Update now</button>
                <button class="btn btn-sm" @onclick="() => _updateAvailable = false">Later</button>
            }
        </div>
    }
</div>
