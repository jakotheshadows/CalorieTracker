@* Name input + one-click USDA search button + results panel, for any editor whose name
   field doubles as the search query. Fills the name when a result is picked (a serving
   rescale of the same food never clobbers a hand-edited name); the parent consumes the
   nutrition via OnApplied. *@
<label class="field span-2">
    <span>@Label <b class="req">*</b></span>
    <div class="name-row">
        <input class="input" value="@Value" @onchange="OnNameChangedAsync" placeholder="@Placeholder" />
        <button class="btn" type="button" title="Search the USDA food database for this name and auto-fill nutrition" @onclick="SearchClickAsync">🔎 Search USDA</button>
        <button class="btn" type="button" title="Scan a product barcode and auto-fill nutrition from USDA" @onclick="ToggleScan">📷 Scan</button>
    </div>
</label>
@if (_scanning)
{
    <div class="field span-full">
        <BarcodeScanner OnDetected="OnBarcodeAsync" OnClose="() => _scanning = false" />
    </div>
}
@if (_open)
{
    <div class="field span-full">
        <UsdaPanel @ref="_panel" Query="@Value" InitialBarcode="@_initialBarcode" OnApplied="HandleAppliedAsync" OnClose="() => _open = false" />
    </div>
}
