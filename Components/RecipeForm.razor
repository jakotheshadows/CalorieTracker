@* Inline editor form for a recipe's metadata (ingredients are managed on the recipe's row). *@
<div class="editor-form">
    <h3>@(OriginalName is null ? "New recipe" : $"Edit “{OriginalName}”")</h3>

    @if (Error is not null)
    {
        <div class="alert-error">@Error</div>
    }

    <div class="form-grid">
        <label class="field span-2">
            <span>Name <b class="req">*</b></span>
            <input class="input" @bind="Recipe.Name" placeholder="e.g. Turkey chili" />
        </label>
        <label class="field">
            <span>Makes (servings) <b class="req">*</b></span>
            <input class="input" type="number" step="any" min="0.25" @bind="Recipe.Servings" />
        </label>
        <label class="field checkbox-field">
            <input type="checkbox" @bind="Recipe.ExcludeFromRandom" />
            <span>Exclude from randomize</span>
        </label>
        <label class="field span-full">
            <span>Description</span>
            <textarea class="input" rows="2" @bind="Recipe.Description" placeholder="Optional notes (markdown supported)"></textarea>
        </label>
    </div>

    @if (OriginalName is null)
    {
        <p class="muted small">After saving, use “+ Ingredient” on the recipe's row to add ingredients one at a time.</p>
    }

    <div class="btn-row editor-actions">
        <button class="btn btn-accent" @onclick="() => OnSave.InvokeAsync()">Save recipe</button>
        <button class="btn" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
    </div>
</div>
