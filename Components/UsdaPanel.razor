@inject UsdaService Usda
@inject NavigationManager Nav

@* USDA FoodData Central results panel. The parent's name field is the search query:
   opening the panel searches immediately, and the parent re-triggers SearchAsync via
   @ref when its search button is clicked again. Every result click or serving change
   fires OnApplied with the food rescaled to the chosen serving. *@
<div class="usda-panel">
    @if (!_hasKey)
    {
        @if (_scannedCode is not null)
        {
            <div class="alert-ok">✅ Barcode read: <b>@_scannedCode</b> — but looking it up needs a USDA API key.</div>
        }
        <p class="muted small">
            Nutrition lookup searches the USDA FoodData Central database and fills in calories,
            macros, and micros for you. It needs a free API key — about a minute to set up
            (instructions are on the Settings page).
        </p>
        <div class="btn-row">
            <button class="btn btn-accent" @onclick="@(() => Nav.NavigateTo("settings"))">Set up in Settings</button>
            <button class="btn" @onclick="CloseAsync">Close</button>
        </div>
    }
    else
    {
        <div class="usda-search-row usda-status-row">
            <span class="muted small">
                @(_busy
                    ? "Searching USDA…"
                    : _lastQuery is null
                        ? "Type a name in the field above, then hit 🔎 Search USDA."
                        : $"USDA results for “{_lastQuery}”")
            </span>
            <span class="spacer"></span>
            <button class="btn" @onclick="CloseAsync">Close</button>
        </div>
        @if (_scannedCode is not null)
        {
            <div class="alert-ok">✅ Barcode read: <b>@_scannedCode</b> — compare with the digits printed under the code.</div>
        }
        @if (_error is not null)
        {
            <div class="alert-error">@_error</div>
        }
        @if (_applied is not null)
        {
            <div class="alert-ok">@_applied</div>
        }
        @if (_selected is not null)
        {
            <div class="usda-serving-row">
                <span class="muted small">My serving is:</span>
                <input class="input input-sm serving-amount" type="number" step="any" min="0"
                       value="@_servAmount" @onchange="e => OnServingAmountChangedAsync(e.Value?.ToString())" />
                <select class="input serving-unit" value="@_servUnit" @onchange="e => OnServingUnitChangedAsync(e.Value?.ToString())">
                    @foreach (var unit in UsdaService.UnitsForBase(_selected.BaseUnit))
                    {
                        <option value="@unit">@unit</option>
                    }
                </select>
                <span class="muted small">— nutrition rescales automatically</span>
            </div>
        }
        @if (_results is not null)
        {
            @if (_results.Count == 0)
            {
                <p class="muted small">No matches — change the name and hit 🔎 Search USDA again.</p>
            }
            else
            {
                <ul class="usda-results">
                    @foreach (var f in _results)
                    {
                        <li @key="f.FdcId" @onclick="() => ApplyAsync(f)" title="Click to fill the form with this food's nutrition">
                            <div class="usda-line1">
                                <span class="item-name">@f.Description</span>
                                <span class="num">@(f.CaloriesFor(f.DefaultAmount) is { } kcal ? $"{kcal:N0} kcal" : "—")</span>
                            </div>
                            <div class="muted small">@(f.Brand is null ? f.DataType : $"{f.Brand} · {f.DataType}") · per @f.DefaultServingDisplay</div>
                        </li>
                    }
                </ul>
                <p class="muted small">Click a result to fill the form — you can adjust anything before saving.</p>
            }
        }
    }
</div>
