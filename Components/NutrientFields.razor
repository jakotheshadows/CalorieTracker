@* Shared macro grid + collapsible micro grid. The parent supplies get/set callbacks,
   so the same markup serves per-serving values, per-amount ingredient values (stored
   per-100 behind the callbacks), and daily randomizer targets. *@
<h4 class="section-label">@MacrosLabel <span class="muted small">(@Suffix)</span></h4>
<div class="form-grid nutrients-grid">
    @foreach (var def in NutrientCatalog.Macros)
    {
        <label class="field" @key="def.Key">
            <span>@def.Label (@def.Unit)</span>
            <input class="input" type="number" step="any" min="0"
                   value="@GetValue(def.Key)"
                   @onchange="e => SetValue(def.Key, e.Value?.ToString())" />
        </label>
    }
</div>

<details class="micros-details" open="@_microsOpen">
    <summary @onclick="ToggleMicros" @onclick:preventDefault="true">
        @MicrosLabel <span class="muted small">(@Suffix)</span>
    </summary>
    <div class="form-grid nutrients-grid">
        @foreach (var def in NutrientCatalog.Micros)
        {
            <label class="field" @key="def.Key">
                <span>@def.Label (@def.Unit)</span>
                <input class="input" type="number" step="any" min="0"
                       value="@GetValue(def.Key)"
                       @onchange="e => SetValue(def.Key, e.Value?.ToString())" />
            </label>
        }
    </div>
</details>
